        <mxCell id="note" value="Flujo principal: transaction-service crea una saga, retira fondos en account-service, publica ApplyPaymentCommand en Kafka, credit-service aplica el pago y transaction-service completa o compensa segun el evento recibido." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=10;" parent="1" vertex="1">
