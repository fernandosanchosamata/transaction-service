        <mxCell id="m1" value="1. POST /auth-service/auth/login" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105" y="215" as="sourcePoint" /><mxPoint x="265" y="215" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. JWT accessToken" style="endArrow=open;html=1;rounded=0;dashed=1;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="265" y="250" as="sourcePoint" /><mxPoint x="105" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3. POST /transaction-service/api/v1/transactions/payments" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105" y="300" as="sourcePoint" /><mxPoint x="425" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4. Validar JWT y reenviar" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425" y="345" as="sourcePoint" /><mxPoint x="600" y="345" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5. Crear saga PAYMENT = CREATED" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="390" as="sourcePoint" /><mxPoint x="1335" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6. VALIDATING_FUNDS y retirar de cuenta origen" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="435" as="sourcePoint" /><mxPoint x="790" y="435" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7. Fondos reservados" style="endArrow=open;html=1;rounded=0;dashed=1;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="470" as="sourcePoint" /><mxPoint x="600" y="470" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8. Actualizar saga = FUNDS_RESERVED" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="515" as="sourcePoint" /><mxPoint x="1335" y="515" as="targetPoint" /></mxGeometry></mxCell>
