        <mxCell id="m10" value="10. credit-service consume comando y aplica pago" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="605" as="sourcePoint" /><mxPoint x="1150" y="605" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="11. Publicar PaymentAppliedEvent" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="650" as="sourcePoint" /><mxPoint x="970" y="650" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12. transaction-service consume evento" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="695" as="sourcePoint" /><mxPoint x="600" y="695" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="13. COMPLETED + publicar TransactionExecutedEvent" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="740" as="sourcePoint" /><mxPoint x="970" y="740" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="14. 202 Accepted + saga CREDITING_DESTINATION" style="endArrow=open;html=1;rounded=0;dashed=1;strokeWidth=1.5;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="790" as="sourcePoint" /><mxPoint x="105" y="790" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="errorNote" value="Compensacion: si credit-service rechaza el pago o falla la publicacion, transaction-service llama account-service /compensations/deposit para devolver fondos a la cuenta origen." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacing=10;" parent="1" vertex="1">
