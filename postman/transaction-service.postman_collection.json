{
  "info": {
    "_postman_id": "2c6e5b2f-1bb5-4d6b-9b53-transaction-service",
    "name": "NTT Bootcamp - Transaction Service via API Gateway",
    "description": "Collection para probar transaction-service a traves de api-gateway. Ejecutar primero Auth / Login - Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "source_account_id",
      "value": "69eaa991e7439a37a1dd72f6"
    },
    {
      "key": "target_account_id",
      "value": "REPLACE_WITH_TARGET_ACCOUNT_ID"
    },
    {
      "key": "credit_id",
      "value": "REPLACE_WITH_CREDIT_ID"
    },
    {
      "key": "transaction_id",
      "value": "REPLACE_WITH_TRANSACTION_ID"
    },
    {
      "key": "amount",
      "value": "100.00"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('access_token', response.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/auth-service/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth-service",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Transferencia procesada', function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "if (response.id) pm.collectionVariables.set('transaction_id', response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{source_account_id}}\",\n  \"targetAccountId\": \"{{target_account_id}}\",\n  \"amount\": {{amount}}\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/transaction-service/api/v1/transactions/transfers",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "transaction-service",
                "api",
                "v1",
                "transactions",
                "transfers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Pay Credit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pago aceptado', function () { pm.response.to.have.status(202); });",
                  "const response = pm.response.json();",
                  "if (response.id) pm.collectionVariables.set('transaction_id', response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceId\": \"{{source_account_id}}\",\n  \"targetId\": \"{{credit_id}}\",\n  \"amount\": {{amount}}\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/transaction-service/api/v1/transactions/payments",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "transaction-service",
                "api",
                "v1",
                "transactions",
                "payments"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Transaction",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/transaction-service/api/v1/transactions/{{transaction_id}}",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "transaction-service",
                "api",
                "v1",
                "transactions",
                "{{transaction_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
